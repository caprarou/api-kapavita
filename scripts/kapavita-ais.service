[Unit]
Description=KapaVita SEAVIOLET AIS position collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/projects/kapavita/app
EnvironmentFile=/home/dev/.config/kapavita-ais/ais.env
ExecStart=/home/dev/.nvm/versions/node/v22.23.3/bin/node /home/dev/projects/kapavita/app/collect-seaviolet-ais.mjs
Restart=always
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/dev/projects/kapavita/app/dist/data /home/dev/.local/share/kapavita

[Install]
WantedBy=multi-user.target
