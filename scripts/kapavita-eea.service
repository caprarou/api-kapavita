[Unit]
Description=KapaVita EEA Greek PM2.5 station collector
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=dev
Group=dev
WorkingDirectory=/home/dev/projects/kapavita/app
ExecStart=/home/dev/.nvm/versions/node/v22.23.3/bin/node /home/dev/projects/kapavita/app/collect-eea-air.mjs
TimeoutStartSec=120
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/dev/.local/share/kapavita
